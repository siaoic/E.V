{
  "name": "maibot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "MaiBot TS 应用层（HTTP/WS/鉴权/配置/Drizzle 数据层）；AI 推理、向量、TTS、插件 Runner 保留 Python 内核",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:schema": "python scripts/dump_schema.py && python scripts/generate_drizzle_schema.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3",
    "pino": "^9.7.0",
    "smol-toml": "^1.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
