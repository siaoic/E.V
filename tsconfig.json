{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/loader/**/*.ts", "src/viewer/**/*.ts", "src/llm/**/*.ts", "src/games/**/*.ts", "src/main.ts", "plugins/**/*.ts"]
}
