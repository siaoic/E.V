{
  // 只有 Node 侧代码,lib 里不放 DOM。要加 Persona 页面板时,面板源码另立一份带 DOM 的配置。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // 开发期把 `cortico/*` 指到平级的框架 checkout;装进宿主运行时不靠它,
    // 那时由框架 `src/extensions/runtime.ts` 的模块钩子解析。改成你的 checkout 路径。
    "paths": {
      "cortico/*": ["../Cortico/src/*"]
    }
  },
  "include": ["index.ts", "persona/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
