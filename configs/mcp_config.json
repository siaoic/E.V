{
  "tavily_remote": {
    "type": "streamable_http",
    "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}",
    "headers": {
      "DEFAULT_PARAMETERS": "{\"include_images\": false, \"max_results\": 5}"
    }
  },
  "playwright": {
    "command": "npx",
    "args": [
      "@playwright/mcp@latest"
    ]
  },
  "tavily_local": {
    "command": "npx",
    "args": [
      "-y",
      "tavily-mcp@latest"
    ],
    "env": {
      "TAVILY_API_KEY": "${TAVILY_API_KEY}"
    }
  },
  "example_time": {
    "command": "python",
    "args": [
      "./tools/example_time.py"
    ]
  }
}