<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>940</width>
    <height>680</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>E.V控制中心</string>
  </property>
  <property name="font">
   <font>
    <family>微软雅黑</family>
    <pointsize>10</pointsize>
   </font>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ============================================================
   E.V 控制中心 · 角色风 QSS
   参考角色图：奶茶棕头发 · 米色开衫 · 玫红缎带 · 浅蓝裙子 · 青绿蝴蝶结
   角色色 → UI 角色：
     米色 #E6D5B8  → 主背景 / 侧边栏（开衫）
     薄荷 #78C8BC  → 主操作 / 强调（蝴蝶结）
     玫红 #DC5A69  → 导航选中 / 标题竖条 / 删除（缎带）
     浅蓝 #9CC8E0  → 动作区次调（裙子）
     暖深棕 #5B4636 → 正文文字（保留）
   ============================================================ */

/* 主窗口 - 透明（背景由 centralwidget 绘制） */
QMainWindow {
	background: transparent;
}

/* 中央部件 - 窗口背景层：米色渐变（角色米色开衫色） + 圆角米色描边 */
QWidget#centralwidget {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(253, 248, 238, 255),
		stop:0.5 rgba(248, 243, 230, 255),
		stop:1 rgba(243, 237, 222, 255));
	border: 1px solid rgba(200, 185, 158, 160);
	border-radius: 25px;
}

/* 侧边栏样式 - 米色渐变（与主内容区一致） */
QFrame#sidebar {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(253, 248, 238, 200),
		stop:0.5 rgba(248, 243, 230, 200),
		stop:1 rgba(243, 237, 222, 200));
	border: 1px solid rgba(200, 185, 158, 200);
	border-radius: 20px;
}

/* 主内容区域 - 米色渐变（与主背景/侧边栏同调，开衫色） */
QFrame#contentArea {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(253, 248, 238, 200),
		stop:0.5 rgba(248, 243, 230, 200),
		stop:1 rgba(243, 237, 222, 200));
	border: 1px solid rgba(200, 185, 158, 200);
	border-radius: 20px;
}

/* 堆叠控件背景 */
QStackedWidget {
	background-color: transparent;
}

/* 页面背景 */
QWidget#page, QWidget#page_llm, QWidget#page_memory, QWidget#page_settings, QWidget#page_about {
	background-color: transparent;
}

/* 标签样式 - 暖深棕文字（角色奶茶棕深调） */
QLabel {
	color: rgb(91, 70, 54);
	background-color: transparent;
}

/* 页面标题样式 - 底部薄荷分隔线 */
QLabel#label_title, QLabel#label_title_launch, QLabel#label_title_llm, QLabel#label_title_memory, QLabel#label_title_settings, QLabel#label_title_face, QLabel#label_title_tools, QLabel#label_title_about {
	color: rgb(91, 70, 54);
	font-size: 17px;
	font-weight: bold;
	background-color: transparent;
	border-bottom: 1px solid rgba(143, 200, 188, 200);
	padding-bottom: 8px;
}

/* 启动页左右分栏标题：小号加粗 + 底部薄荷分隔线（对话 / 工具日志） */
QLabel#label_log_chat, QLabel#label_log_tool {
	color: rgb(91, 70, 54);
	font-size: 12px;
	font-weight: bold;
	background-color: transparent;
	border-bottom: 1px solid rgba(143, 200, 188, 200);
	padding-bottom: 2px;
}

/* 设置页小节标题（选项 / 语音识别 / Agent模型 / 嵌入模型 / B站弹幕）：
   加粗 + 左侧玫红竖条（角色缎带色） */
QLabel#label_title_options, QLabel#label_title_stt, QLabel#label_title_butler,
QLabel#label_title_emb, QLabel#label_title_bili {
	color: rgb(91, 70, 54);
	font-size: 14px;
	font-weight: bold;
	background-color: transparent;
	border-left: 4px solid rgb(220, 90, 105);
	padding-left: 8px;
	margin-top: 4px;
}

/* 输入框样式 - 米白毛玻璃 */
QLineEdit {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 250, 245, 255), stop:1 rgba(248, 246, 240, 255));
	border: 1px solid rgba(180, 200, 195, 200);
	border-radius: 10px;
	padding: 6px 9px;
	color: rgb(91, 70, 54);
}

QLineEdit:focus {
	border: 2px solid rgb(120, 200, 188);
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(230, 245, 240, 255), stop:1 rgba(240, 248, 244, 255));
}

/* 文本编辑框样式 - 米白毛玻璃 */
QTextEdit, QTextBrowser {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 250, 245, 255), stop:1 rgba(248, 246, 240, 255));
	border: 1px solid rgba(180, 200, 195, 200);
	border-radius: 14px;
	padding: 10px;
	color: rgb(91, 70, 54);
}

QTextEdit:focus, QTextBrowser:focus {
	border: 2px solid rgb(120, 200, 188);
}

/* 复选框 / 单选：薄荷描边 + 玫红选中（角色缎带色） */
QCheckBox, QRadioButton {
	color: rgb(91, 70, 54);
	spacing: 10px;
	background-color: transparent;
}

QCheckBox::indicator {
	width: 16px;
	height: 16px;
	border-radius: 4px;
	border: 2px solid rgb(143, 200, 188);
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(240, 248, 244, 255), stop:1 rgba(248, 246, 240, 255));
}

QCheckBox::indicator:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(120, 200, 188, 255), stop:1 rgba(90, 175, 160, 255));
	border: 2px solid rgb(70, 145, 130);
}

QCheckBox::indicator:hover {
	border: 2px solid rgb(120, 200, 188);
}

QRadioButton::indicator {
	width: 16px;
	height: 16px;
	border-radius: 8px;
	border: 2px solid rgb(143, 200, 188);
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(240, 248, 244, 255), stop:1 rgba(248, 246, 240, 255));
}

QRadioButton::indicator:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(120, 200, 188, 255), stop:1 rgba(90, 175, 160, 255));
	border: 2px solid rgb(70, 145, 130);
}

/* 通用按钮 - 米白底，hover 偏薄荷（蝴蝶结色） */
QPushButton {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(252, 250, 245, 255),
		stop:0.5 rgba(248, 246, 240, 255),
		stop:1 rgba(244, 242, 235, 255));
	color: rgb(91, 70, 54);
	border: 1px solid rgba(180, 200, 195, 180);
	border-radius: 8px;
	padding: 10px 20px;
	font-size: 13px;
	font-family: "微软雅黑";
}

QPushButton:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(210, 235, 225, 255), stop:1 rgba(190, 225, 215, 255));
	color: rgb(60, 110, 95);
}

QPushButton:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(190, 220, 210, 255), stop:1 rgba(170, 215, 200, 255));
}

QPushButton:disabled {
	color: rgb(180, 200, 195);
}

/* 侧边栏导航按钮：粗体 */
QPushButton#nav_launch, QPushButton#nav_llm, QPushButton#nav_memory, QPushButton#nav_settings, QPushButton#nav_face, QPushButton#nav_tools, QPushButton#nav_about {
	font-weight: bold;
}

/* 选中态：玫红渐变（角色缎带色），与「启动」「LLM配置」选中页一致 */
QPushButton#nav_launch:checked, QPushButton#nav_llm:checked, QPushButton#nav_memory:checked, QPushButton#nav_settings:checked, QPushButton#nav_face:checked, QPushButton#nav_tools:checked, QPushButton#nav_about:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(230, 104, 122, 255), stop:1 rgba(220, 90, 105, 255));
	border: 1px solid rgba(180, 69, 83, 220);
	color: rgb(252, 250, 245);
}

/* 底部「更新配置」按钮：薄荷主操作（角色蝴蝶结色） */
QPushButton#btn_save_config {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(140, 215, 200, 255),
		stop:0.5 rgba(120, 200, 188, 255),
		stop:1 rgba(105, 185, 172, 255));
	color: rgb(252, 250, 245);
	font-size: 14px;
	padding: 12px 20px;
	border-radius: 10px;
	border: 1px solid rgba(70, 145, 138, 220);
}

QPushButton#btn_save_config:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(155, 220, 200, 255), stop:1 rgba(135, 205, 188, 255));
	color: rgb(252, 250, 245);
}

/* 表情与动作页 - 整页滚动区（无边框透明） */
QScrollArea#scroll_face_page {
	background: transparent;
	border: none;
}

QScrollArea#scroll_face_page > QWidget > QWidget,
QScrollArea#scroll_face_page > QWidget,
QWidget#widget_face_page {
	background: transparent;
}

/* 设置页滚动区 - 无边框透明 */
QScrollArea#scroll_settings_page {
	background: transparent;
	border: none;
}

QScrollArea#scroll_settings_page > QWidget > QWidget,
QScrollArea#scroll_settings_page > QWidget,
QWidget#widget_settings_page {
	background: transparent;
}

/* 情绪绑定区大背景：薄荷渐变（蝴蝶结色）+ 薄荷实边
   边框改实色：FramelessWindowHint + WA_TranslucentBackground 的无边框半透明窗口下，
   半透明 rgba 边框经 alpha 合成后圆角处极易断线/过淡，必须用 rgb 实色 */
QFrame#card_emotion_zone {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(232, 244, 240, 235),
		stop:0.5 rgba(222, 237, 232, 235),
		stop:1 rgba(210, 229, 222, 235));
	border: 2px solid rgb(143, 200, 188);
	border-radius: 12px;
}

/* 情绪区内部 widget 透明 */
QWidget#widget_emotion_zone {
	background: transparent;
}

/* 情绪绑定区卡片：米白底 + 虚线薄荷边，悬停实色高亮 */
QFrame#emotion_card {
	background: rgba(252, 252, 248, 235);
	border: 1.5px dashed rgba(143, 200, 188, 210);
	border-radius: 10px;
}

QFrame#emotion_card:hover {
	border: 1.5px solid rgba(120, 200, 188, 235);
	background: rgba(248, 252, 250, 240);
}

/* 情绪名：玫红粗体（角色缎带色，对齐 HTML .emotion-card .name） */
QLabel#emotion_name {
	color: rgb(192, 74, 88);
	font-size: 14px;
	font-weight: bold;
	background: transparent;
}

/* 情绪槽位 - 未绑定：淡薄荷底 + 虚线薄荷边 */
QLabel#slot_empty {
	background: rgba(238, 248, 244, 200);
	border: 1.5px dashed rgba(143, 200, 188, 215);
	border-radius: 8px;
	color: rgb(110, 165, 150);
	padding: 6px 6px;
	font-size: 12px;
}

/* 情绪槽位 - 拖拽悬停高亮（薄荷底加深） */
QLabel#slot_empty[drag="true"] {
	background: rgba(210, 235, 225, 235);
	border: 1.5px dashed rgb(95, 184, 170);
	color: rgb(63, 120, 105);
}

/* 情绪槽位 - 已绑定：薄荷渐变 + 薄荷实边 */
QLabel#slot_filled {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(210, 235, 225, 255),
		stop:1 rgba(190, 222, 201, 255));
	border: 1.5px solid rgba(110, 190, 170, 230);
	border-radius: 8px;
	color: rgb(60, 120, 105);
	font-weight: bold;
	padding: 6px 6px;
	font-size: 13px;
}

/* 表情库按钮：薄荷渐变（蝴蝶结色） */
QPushButton#expr_btn {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(232, 245, 238, 255),
		stop:0.5 rgba(222, 240, 232, 255),
		stop:1 rgba(208, 232, 220, 255));
	border: 1px solid rgba(143, 200, 188, 190);
	border-radius: 10px;
	color: rgb(63, 149, 137);
	padding: 10px 12px;
	font-size: 13px;
	font-weight: 500;
}

QPushButton#expr_btn:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(210, 235, 225, 255),
		stop:0.5 rgba(195, 225, 215, 255),
		stop:1 rgba(180, 220, 205, 255));
	border: 1.5px solid rgba(120, 200, 188, 215);
	color: rgb(50, 130, 115);
}

QPushButton#expr_btn:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(190, 222, 205, 255),
		stop:0.5 rgba(175, 215, 195, 255),
		stop:1 rgba(160, 208, 185, 255));
}

/* 表情库外框：浅色背景 + 薄荷描边 */
QFrame#card_expr_library {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 249, 244, 220),
		stop:1 rgba(248, 246, 240, 220));
	border: 1px solid rgb(180, 200, 195);
	border-radius: 12px;
}

/* 表情库 widget 内部透明 */
QWidget#widget_expr_library {
	background: transparent;
}

/* 动作绑定区域卡片：米白底（与表情库外框同底色） */
QFrame#card_action_bind {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 249, 244, 220),
		stop:1 rgba(248, 246, 240, 220));
	border: 1px solid rgb(168, 184, 224);
	border-radius: 12px;
}

/* 动作库内部 widget 透明 */
QWidget#widget_action_library {
	background: transparent;
}

/* 工具卡片：米色（与主背景同调，融入整体） */
QFrame#card_tool_status {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(253, 248, 238, 220),
		stop:1 rgba(248, 243, 230, 220));
	border: 1px solid rgb(200, 185, 158);
	border-radius: 12px;
}

/* 工具卡片内部标题：浅蓝粗体（角色裙子色） */
QLabel#label_tool_status_title {
	color: rgb(63, 110, 146);
	font-size: 13px;
	font-weight: bold;
	background: transparent;
}

/* 动作绑定区标题：玫红粗体（角色缎带色） */
QLabel#label_action_title {
	color: rgb(220, 90, 105);
	font-size: 13px;
	font-weight: bold;
	background: transparent;
}

/* 动作卡片按钮：蓝紫渐变（与 #dce6ff 动作区同调） */
QPushButton#motion_card {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(240, 244, 255, 255),
		stop:0.5 rgba(231, 237, 255, 255),
		stop:1 rgba(222, 230, 255, 255));
	border: 1px solid rgba(168, 184, 224, 200);
	border-radius: 10px;
	color: rgb(70, 105, 165);
	padding: 10px 12px;
	font-size: 13px;
	font-weight: 500;
}

QPushButton#motion_card:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(226, 233, 252, 255),
		stop:0.5 rgba(215, 225, 248, 255),
		stop:1 rgba(204, 217, 244, 255));
	border: 1.5px solid rgba(140, 162, 210, 215);
	color: rgb(55, 90, 155);
}

QPushButton#motion_card:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(206, 219, 244, 255),
		stop:0.5 rgba(193, 209, 240, 255),
		stop:1 rgba(180, 199, 236, 255));
}

/* 动作槽位 - 未绑定：淡蓝紫底 + 虚线蓝紫边（与情绪槽位薄荷区分） */
QLabel#slot_empty_motion {
	background: rgba(240, 244, 255, 200);
	border: 1.5px dashed rgba(168, 184, 224, 215);
	border-radius: 8px;
	color: rgb(110, 130, 180);
	padding: 6px 6px;
	font-size: 12px;
}

/* 动作槽位 - 拖拽悬停高亮（蓝紫底加深） */
QLabel#slot_empty_motion[drag="true"] {
	background: rgba(222, 231, 252, 235);
	border: 1.5px dashed rgb(140, 162, 210);
	color: rgb(60, 95, 160);
}

/* 动作槽位 - 已绑定：蓝紫渐变 + 蓝紫实边 */
QLabel#slot_filled_motion {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(222, 231, 252, 255),
		stop:1 rgba(205, 217, 244, 255));
	border: 1.5px solid rgba(140, 162, 210, 230);
	border-radius: 8px;
	color: rgb(55, 90, 155);
	font-weight: bold;
	padding: 6px 6px;
	font-size: 13px;
}

/* 动作绑定区大背景：#dce6ff 浅蓝紫渐变 + 同色系深一档描边 */
QFrame#card_motion_zone {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(232, 238, 255, 235),
		stop:0.5 rgba(220, 230, 255, 235),
		stop:1 rgba(207, 220, 255, 235));
	border: 2px solid rgb(168, 184, 224);
	border-radius: 12px;
}

/* 动作绑定区内部 widget 透明 */
QWidget#widget_motion_zone {
	background: transparent;
}

/* 动作绑定区卡片：米白底 + 无线框，悬停仅背景变化 */
QFrame#motion_zone_card {
	background: rgba(252, 252, 250, 235);
	border: none;
	border-radius: 10px;
}

QFrame#motion_zone_card:hover {
	background: rgba(248, 250, 254, 240);
}

/* 一键还原按钮：表情区薄荷 / 动作区蓝紫（与 #dce6ff 同调） */
QPushButton#btn_reset_expr {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(210, 235, 225, 255), stop:1 rgba(190, 222, 201, 255));
	color: rgb(60, 120, 105);
	border: 1px solid rgba(143, 200, 188, 195);
	border-radius: 10px;
	padding: 8px 14px;
	font-size: 13px;
}

QPushButton#btn_reset_expr:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(190, 222, 205, 255), stop:1 rgba(170, 215, 195, 255));
	border: 1px solid rgb(95, 184, 170);
}

QPushButton#btn_reset_action {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(226, 233, 250, 255), stop:1 rgba(214, 225, 246, 255));
	color: rgb(70, 105, 165);
	border: 1px solid rgba(168, 184, 224, 200);
	border-radius: 10px;
	padding: 8px 14px;
	font-size: 13px;
}

QPushButton#btn_reset_action:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(204, 217, 242, 255), stop:1 rgba(188, 206, 238, 255));
	border: 1px solid rgb(140, 162, 210);
}

/* 情绪绑定区/表情库/动作库子标题：玫红粗体（角色缎带色，对齐 HTML） */
QLabel#label_emotion_title, QLabel#label_expr_title, QLabel#label_action_lib_title {
	color: rgb(192, 74, 88);
	font-size: 13px;
	font-weight: bold;
	background: transparent;
}

/* 列表/表格：米白毛玻璃 + 圆角，薄荷选中 */
QListWidget, QTableWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 250, 245, 255), stop:1 rgba(248, 246, 240, 255));
	border: 1px solid rgba(180, 200, 195, 200);
	border-radius: 10px;
	color: rgb(91, 70, 54);
}

QListWidget::item {
	padding: 4px 8px;
	border-radius: 6px;
}

QListWidget::item:hover {
	background: rgba(220, 240, 230, 255);
}

QListWidget::item:selected {
	background: rgba(143, 200, 188, 255);
	color: rgb(40, 70, 60);
}

QTableWidget {
	gridline-color: rgba(180, 200, 195, 120);
}

QTableWidget::item {
	padding: 4px;
}

QTableWidget::item:selected {
	background: rgba(143, 200, 188, 255);
	color: rgb(40, 70, 60);
}

/* 工具表格：透明无边框，背景由容器裁剪 */
QTableWidget#table_tool_status {
	background: transparent;
	border: none;
	border-radius: 0px;
	alternate-background-color: rgba(245, 248, 240, 255);
	gridline-color: rgba(180, 200, 195, 120);
}

/* 表头圆角：与容器圆角对齐 */
QTableWidget#table_tool_status QHeaderView::section:first {
	border-top-left-radius: 12px;
}
QTableWidget#table_tool_status QHeaderView::section:last {
	border-top-right-radius: 12px;
}

QHeaderView::section {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(232, 240, 234, 255), stop:1 rgba(220, 232, 224, 255));
	color: rgb(91, 70, 54);
	border: none;
	border-bottom: 1px solid rgba(143, 200, 188, 200);
	padding: 6px 8px;
	font-weight: bold;
}

/* QComboBox 下拉框：薄荷聚焦边 */
QComboBox {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 250, 245, 255), stop:1 rgba(248, 246, 240, 255));
	border: 1px solid rgba(180, 200, 195, 200);
	border-radius: 14px;
	padding: 6px 9px;
	padding-right: 34px;
	color: rgb(91, 70, 54);
}

QComboBox:focus {
	border: 2px solid rgb(120, 200, 188);
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(230, 245, 240, 255), stop:1 rgba(240, 248, 244, 255));
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 30px;
	border-left: 1px solid rgba(180, 200, 195, 200);
	border-top-right-radius: 14px;
	border-bottom-right-radius: 14px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(232, 240, 234, 255), stop:1 rgba(220, 232, 224, 255));
}

QComboBox::down-arrow {
	width: 12px;
	height: 12px;
	image: none;
	border: 2px solid rgb(91, 70, 54);
	border-top: none;
	border-right: none;
	margin: 5px;
}

QComboBox QAbstractItemView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 250, 245, 255), stop:1 rgba(248, 246, 240, 255));
	border: 1px solid rgba(180, 200, 195, 200);
	border-radius: 8px;
	selection-background-color: rgba(143, 200, 188, 255);
	color: rgb(91, 70, 54);
	padding: 5px;
}

/* 控制面板样式 */
QFrame#control_panel_frame {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(248, 245, 240, 255), stop:1 rgba(240, 238, 230, 255));
	border: 1px solid rgba(180, 200, 195, 180);
	border-radius: 15px;
}

/* 滚动条样式：竖 = 玫红（缎带色），横 = 薄荷（蝴蝶结色）
   背景透明 + 上下留圆角空间，避免不透明轨道盖住表格圆角 */
QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 11px 1px;
	border-radius: 5px;
}

QScrollBar::handle:vertical {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(230, 104, 122, 255), stop:1 rgba(200, 80, 96, 255));
	border-radius: 5px;
	min-height: 20px;
	margin: 1px;
}

QScrollBar::handle:vertical:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(245, 130, 145, 255), stop:1 rgba(220, 100, 115, 255));
}

QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 1px 11px;
	border-radius: 5px;
}

QScrollBar::handle:horizontal {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(120, 200, 188, 255), stop:1 rgba(95, 184, 170, 255));
	border-radius: 5px;
	min-width: 20px;
	margin: 1px;
}

QScrollBar::handle:horizontal:hover {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(140, 215, 200, 255), stop:1 rgba(120, 200, 188, 255));
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	width: 0px;
	height: 0px;
}

/* 记忆页视图容器 */
#stack_memory {
	border: 1px solid rgba(180, 200, 195, 160);
	border-radius: 10px;
	background: rgba(252, 249, 244, 200);
}

/* 记忆图谱视图 */
#graph_memory {
	border: 1px solid rgba(180, 200, 195, 160);
	border-radius: 8px;
}

/* 记忆页 - 顶部状态栏：浅薄荷灰文字 */
QLabel#label_memory_status {
	color: rgb(150, 165, 158);
	font-size: 12px;
}

/* 记忆页 - 视图切换按钮：薄荷主操作（角色蝴蝶结色） */
QPushButton#btn_memory_view_toggle {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(140, 215, 200, 255),
		stop:0.5 rgba(120, 200, 188, 255),
		stop:1 rgba(105, 185, 172, 255));
	color: rgb(252, 250, 245);
	border: 1px solid rgba(70, 145, 138, 220);
	border-radius: 8px;
	padding: 8px 18px;
	font-size: 12px;
}

QPushButton#btn_memory_view_toggle:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(155, 220, 200, 255), stop:1 rgba(135, 205, 188, 255));
}

QPushButton#btn_memory_view_toggle:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(95, 175, 160, 255), stop:1 rgba(80, 155, 140, 255));
}

/* 记忆页 - 刷新按钮：紧凑尺寸 */
QPushButton#btn_memory_refresh {
	padding: 8px 16px;
	font-size: 12px;
	border-radius: 8px;
}

/* 记忆表格：悬停行高亮薄荷 */
QTableWidget#table_memory::item {
	padding: 4px 8px;
	border: none;
}

QTableWidget#table_memory::item:hover {
	background: rgba(220, 240, 230, 255);
}

/* 记忆详情弹窗文本 */
QPlainTextEdit {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(252, 250, 245, 255), stop:1 rgba(248, 246, 240, 255));
	border: 1px solid rgba(180, 200, 195, 200);
	border-radius: 14px;
	padding: 10px;
	color: rgb(91, 70, 54);
}

QPlainTextEdit:focus {
	border: 2px solid rgb(120, 200, 188);
}
</string>
