<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>940</width>
    <height>680</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>E.V控制中心</string>
  </property>
  <property name="font">
   <font>
    <family>微软雅黑</family>
    <pointsize>10</pointsize>
   </font>
  </property>
  <property name="styleSheet">
   <string notr="true">/* 主窗口 - 透明（背景由 centralwidget 绘制；无边框 + 透明背景窗口下
   QMainWindow 自身不渲染 QSS 背景，画在这里会导致背景丢失） */
QMainWindow {
	background: transparent;
}

/* 中央部件 - 窗口背景层：浅色渐变 + 圆角外边框
   （纯 QWidget 的 QSS 背景会自动绘制，配合窗口透明背景四角显示圆角） */
QWidget#centralwidget {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(250, 249, 245, 255), stop:0.5 rgba(245, 243, 235, 255), stop:1 rgba(240, 238, 230, 255));
	border: 1px solid rgba(160, 155, 145, 150);
	border-radius: 25px;
}

/* 侧边栏样式 - 浅灰渐变 + 柔和描边 */
QFrame#sidebar {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(235, 233, 225, 200), stop:0.5 rgba(230, 228, 220, 200), stop:1 rgba(225, 223, 215, 200));
	border: 1px solid rgba(200, 195, 185, 180);
	border-radius: 20px;
}

/* 主内容区域 - 浅色毛玻璃效果 + 柔和描边 */
QFrame#contentArea {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(240, 238, 230, 200), stop:0.5 rgba(235, 233, 225, 200), stop:1 rgba(230, 228, 220, 200));
	border: 1px solid rgba(200, 195, 185, 200);
	border-radius: 20px;
}

/* 堆叠控件背景 */
QStackedWidget {
	background-color: transparent;
}

/* 页面背景 */
QWidget#page, QWidget#page_llm, QWidget#page_memory, QWidget#page_settings, QWidget#page_about {
	background-color: transparent;
}

/* 标签样式 */
QLabel {
	color: rgb(114, 95, 77);
	background-color: transparent;
}

/* 页面标题样式 - 底部细分隔线 */
QLabel#label_title, QLabel#label_title_launch, QLabel#label_title_llm, QLabel#label_title_memory, QLabel#label_title_settings, QLabel#label_title_face, QLabel#label_title_tools, QLabel#label_title_about {
	color: rgb(85, 70, 55);
	font-size: 17px;
	font-weight: bold;
	background-color: transparent;
	border-bottom: 1px solid rgba(200, 195, 185, 200);
	padding-bottom: 8px;
}

/* 设置页小节标题（选项 / 语音识别 / Agent模型 / 嵌入模型 / B站弹幕）：
   加粗 + 左侧深棕竖条，与普通文字明显区分 */
QLabel#label_title_options, QLabel#label_title_stt, QLabel#label_title_butler,
QLabel#label_title_emb, QLabel#label_title_bili {
	color: rgb(85, 70, 55);
	font-size: 14px;
	font-weight: bold;
	background-color: transparent;
	border-left: 4px solid rgb(150, 128, 100);
	padding-left: 8px;
	margin-top: 4px;
}

/* 输入框样式 - 浅色毛玻璃效果 */
QLineEdit {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(250, 249, 245, 255), stop:1 rgba(248, 247, 242, 255));
border: 1px solid rgba(180, 175, 165, 200);
	border-radius: 10px;
	padding: 6px 9px;
	color: rgb(114, 95, 77);
}

QLineEdit:focus {
	border: 2px solid rgb(140, 135, 125);
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(215, 213, 205, 255), stop:1 rgba(225, 223, 215, 255));
}

/* 文本编辑框样式 - 浅色毛玻璃效果 */
QTextEdit, QTextBrowser {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(250, 249, 245, 255), stop:1 rgba(248, 247, 242, 255));
border: 1px solid rgba(180, 175, 165, 200);
	border-radius: 14px;
	padding: 10px;
	color: rgb(114, 95, 77);
}

QTextEdit:focus, QTextBrowser:focus {
	border: 2px solid rgb(140, 135, 125);
}

/* 复选框样式 */
QCheckBox, QRadioButton {
	color: rgb(114, 95, 77);
	spacing: 10px;
	background-color: transparent;
}

QCheckBox::indicator {
	width: 16px;
	height: 16px;
	border-radius: 4px;
	border: 2px solid rgb(140, 135, 125);
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(230, 228, 220, 255), stop:1 rgba(240, 238, 230, 255));
}

QCheckBox::indicator:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(120, 115, 105, 255), stop:1 rgba(100, 95, 85, 255));
	border: 2px solid rgb(80, 75, 65);
}

QCheckBox::indicator:hover {
	border: 2px solid rgb(100, 95, 85);
}

QRadioButton::indicator {
	width: 16px;
	height: 16px;
	border-radius: 8px;
	border: 2px solid rgb(140, 135, 125);
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(230, 228, 220, 255), stop:1 rgba(240, 238, 230, 255));
}

QRadioButton::indicator:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(120, 115, 105, 255), stop:1 rgba(100, 95, 85, 255));
	border: 2px solid rgb(80, 75, 65);
}

/* 通用按钮样式（严格对齐 test222.ui 全局 QPushButton） */
QPushButton {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(250, 249, 245, 255), stop:0.5 rgba(248, 247, 242, 255), stop:1 rgba(245, 244, 240, 255));
	color: rgb(114, 95, 77);
	border: 1px solid rgba(160, 155, 145, 180);
	border-radius: 8px;
	padding: 10px 20px;
	font-size: 13px;
	font-family: "微软雅黑";
}

QPushButton:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(180, 175, 165, 255), stop:1 rgba(170, 165, 155, 255));
	color: rgb(40, 35, 25);
}

QPushButton:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(160, 155, 145, 255), stop:1 rgba(150, 145, 135, 255));
}

QPushButton:disabled {
	color: rgb(160, 155, 145);
}

/* 侧边栏导航按钮：继承通用按钮样式；粗体对齐 test222 导航按钮（微软雅黑 10pt bold） */
QPushButton#nav_launch, QPushButton#nav_llm, QPushButton#nav_memory, QPushButton#nav_settings, QPushButton#nav_face, QPushButton#nav_tools, QPushButton#nav_about {
	font-weight: bold;
}

/* 选中态温和高亮（test222 无 :checked 样式，此处仅作当前页反馈） */
QPushButton#nav_launch:checked, QPushButton#nav_llm:checked, QPushButton#nav_memory:checked, QPushButton#nav_settings:checked, QPushButton#nav_face:checked, QPushButton#nav_tools:checked, QPushButton#nav_about:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(205, 200, 190, 255), stop:1 rgba(195, 190, 180, 255));
	border: 1px solid rgba(140, 135, 125, 220);
	color: rgb(40, 35, 25);
}

/* 底部「更新配置」按钮（对齐 test222 #saveConfigButton 深灰渐变 + 全宽） */
QPushButton#btn_save_config {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(200, 195, 185, 255), stop:0.5 rgba(190, 185, 175, 255), stop:1 rgba(210, 205, 195, 255));
	color: rgb(70, 65, 55);
	font-size: 14px;
	padding: 12px 20px;
	border-radius: 10px;
}

QPushButton#btn_save_config:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(170, 165, 155, 255), stop:1 rgba(160, 155, 145, 255));
	color: rgb(40, 35, 25);
}

/* 表情与动作页 - 整页滚动区（无边框透明：内容超高时整页滚动，不再分块滚动） */
QScrollArea#scroll_face_page {
	background: transparent;
	border: none;
}

QScrollArea#scroll_face_page > QWidget > QWidget,
QScrollArea#scroll_face_page > QWidget,
QWidget#widget_face_page {
	background: transparent;
}

/* 设置页滚动区 - 无边框透明（同表情页，防默认白色背景顶掉页面暖色底） */
QScrollArea#scroll_settings_page {
	background: transparent;
	border: none;
}

QScrollArea#scroll_settings_page > QWidget > QWidget,
QScrollArea#scroll_settings_page > QWidget,
QWidget#widget_settings_page {
	background: transparent;
}

/* 情绪绑定区大背景（暖米棕渐变 + 棕描边，对齐整体暖色系） */
QFrame#card_emotion_zone {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(248, 243, 235, 235),
		stop:0.5 rgba(243, 236, 224, 235),
		stop:1 rgba(238, 229, 214, 235));
	border: 2px solid rgba(195, 180, 158, 210);
	border-radius: 12px;
}

/* 情绪区内部 widget 透明，让大背景区显示出来 */
QWidget#widget_emotion_zone {
	background: transparent;
}

/* 情绪绑定区卡片（米白底 + 虚线浅棕边框，悬停实色高亮） */
QFrame#emotion_card {
	background: rgba(255, 254, 251, 235);
	border: 1.5px dashed rgba(195, 180, 158, 210);
	border-radius: 10px;
}

QFrame#emotion_card:hover {
	border: 1.5px solid rgba(180, 162, 138, 235);
	background: rgba(255, 253, 249, 240);
}

/* 情绪名：暖棕粗体 */
QLabel#emotion_name {
	color: rgb(140, 118, 92);
	font-size: 14px;
	font-weight: bold;
	background: transparent;
}

/* 情绪槽位 - 未绑定：浅米底 + 虚线浅棕边 */
QLabel#slot_empty {
	background: rgba(251, 247, 240, 200);
	border: 1.5px dashed rgba(190, 175, 153, 215);
	border-radius: 8px;
	color: rgb(165, 150, 130);
	padding: 6px 6px;
	font-size: 12px;
}

/* 情绪槽位 - 拖拽悬停高亮（米棕底加深） */
QLabel#slot_empty[drag="true"] {
	background: rgba(238, 228, 212, 235);
	border: 1.5px dashed rgb(170, 148, 118);
	color: rgb(110, 92, 68);
}

/* 情绪槽位 - 已绑定：暖米棕渐变 + 棕实边 */
QLabel#slot_filled {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(240, 233, 220, 255),
		stop:1 rgba(230, 219, 200, 255));
	border: 1.5px solid rgba(185, 168, 142, 230);
	border-radius: 8px;
	color: rgb(105, 88, 64);
	font-weight: bold;
	padding: 6px 6px;
	font-size: 13px;
}

/* 表情库按钮（暖米棕渐变，对齐全局按钮；立体感暗示可交互） */
QPushButton#expr_btn {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(250, 246, 238, 255),
		stop:0.5 rgba(247, 240, 229, 255),
		stop:1 rgba(244, 235, 221, 255));
	border: 1px solid rgba(190, 172, 148, 190);
	border-radius: 10px;
	color: rgb(130, 108, 82);
	padding: 10px 12px;
	font-size: 13px;
	font-weight: 500;
}

QPushButton#expr_btn:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(238, 230, 216, 255),
		stop:0.5 rgba(233, 222, 204, 255),
		stop:1 rgba(228, 214, 194, 255));
	border: 1.5px solid rgba(170, 148, 118, 215);
	color: rgb(95, 75, 52);
}

QPushButton#expr_btn:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(226, 216, 198, 255),
		stop:0.5 rgba(220, 208, 188, 255),
		stop:1 rgba(215, 202, 180, 255));
}

/* 表情库外框（按图：浅色背景 + 浅灰描边，无紫色描边） */
QFrame#card_expr_library {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(250, 249, 245, 220),
		stop:1 rgba(245, 243, 235, 220));
	border: 1px solid rgba(200, 195, 185, 160);
	border-radius: 12px;
}

/* 表情库 widget 内部透明 */
QWidget#widget_expr_library {
	background: transparent;
}

/* 动作绑定区域卡片（浅色渐变圆角，与表情库卡片一致） */
QFrame#card_action_bind {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(250, 249, 245, 220),
		stop:1 rgba(245, 243, 235, 220));
	border: 1px solid rgba(200, 195, 185, 160);
	border-radius: 12px;
}

/* 动作库内部 widget 透明 */
QWidget#widget_action_library {
	background: transparent;
}

/* 工具卡片（浅色渐变圆角，与表情库/动作库卡片一致） */
QFrame#card_tool_status {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(250, 249, 245, 220),
		stop:1 rgba(245, 243, 235, 220));
	border: 1px solid rgba(200, 195, 185, 160);
	border-radius: 12px;
}

/* 工具卡片内部标题（粗体，与情绪区/动作区标题一致） */
QLabel#label_tool_status_title {
	color: rgb(60, 95, 160);
	font-size: 13px;
	font-weight: bold;
	background: transparent;
}

/* 动作绑定区标题（灰棕粗体，与整体暖色系一致） */
QLabel#label_action_title {
	color: rgb(122, 122, 104);
	font-size: 13px;
	font-weight: bold;
	background: transparent;
}

/* 动作卡片按钮（浅灰棕渐变，对齐全局按钮；与表情库按钮同调性） */
QPushButton#motion_card {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(244, 244, 239, 255),
		stop:0.5 rgba(239, 239, 232, 255),
		stop:1 rgba(234, 235, 226, 255));
	border: 1px solid rgba(185, 185, 168, 190);
	border-radius: 10px;
	color: rgb(122, 122, 104);
	padding: 10px 12px;
	font-size: 13px;
	font-weight: 500;
}

QPushButton#motion_card:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(232, 233, 224, 255),
		stop:0.5 rgba(225, 226, 215, 255),
		stop:1 rgba(218, 220, 207, 255));
	border: 1.5px solid rgba(160, 160, 142, 215);
	color: rgb(88, 88, 72);
}

QPushButton#motion_card:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(220, 222, 210, 255),
		stop:0.5 rgba(212, 214, 200, 255),
		stop:1 rgba(205, 207, 192, 255));
}

/* 动作槽位 - 未绑定：浅灰底 + 虚线浅灰边（与表情槽位浅棕区分） */
QLabel#slot_empty_motion {
	background: rgba(248, 248, 243, 200);
	border: 1.5px dashed rgba(180, 180, 165, 215);
	border-radius: 8px;
	color: rgb(158, 158, 142);
	padding: 6px 6px;
	font-size: 12px;
}

/* 动作槽位 - 拖拽悬停高亮（灰底加深） */
QLabel#slot_empty_motion[drag="true"] {
	background: rgba(231, 231, 220, 235);
	border: 1.5px dashed rgb(155, 155, 135);
	color: rgb(100, 100, 84);
}

/* 动作槽位 - 已绑定：浅灰棕渐变 + 灰实边 */
QLabel#slot_filled_motion {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(235, 236, 228, 255),
		stop:1 rgba(223, 225, 214, 255));
	border: 1.5px solid rgba(175, 175, 158, 230);
	border-radius: 8px;
	color: rgb(96, 96, 80);
	font-weight: bold;
	padding: 6px 6px;
	font-size: 13px;
}

/* 动作绑定区大背景（浅灰棕渐变 + 灰描边，与表情区暖米棕同调性） */
QFrame#card_motion_zone {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
		stop:0 rgba(243, 243, 238, 235),
		stop:0.5 rgba(236, 237, 230, 235),
		stop:1 rgba(229, 231, 222, 235));
	border: 2px solid rgba(185, 185, 170, 210);
	border-radius: 12px;
}

/* 动作绑定区内部 widget 透明，让大背景区显示出来 */
QWidget#widget_motion_zone {
	background: transparent;
}

/* 动作绑定区卡片（米白底 + 虚线浅灰边框，悬停实色高亮） */
QFrame#motion_zone_card {
	background: rgba(255, 255, 253, 235);
	border: 1.5px dashed rgba(185, 185, 170, 210);
	border-radius: 10px;
}

QFrame#motion_zone_card:hover {
	border: 1.5px solid rgba(168, 168, 150, 235);
	background: rgba(253, 253, 250, 240);
}

/* 一键还原按钮：表情区暖米棕 / 动作区浅灰棕 */
QPushButton#btn_reset_expr {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(238, 230, 216, 255), stop:1 rgba(233, 222, 204, 255));
	color: rgb(110, 90, 66);
	border: 1px solid rgba(180, 162, 138, 195);
	border-radius: 10px;
	padding: 8px 14px;
	font-size: 13px;
}

QPushButton#btn_reset_expr:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(226, 214, 194, 255), stop:1 rgba(218, 202, 178, 255));
	border: 1px solid rgb(150, 126, 96);
}

QPushButton#btn_reset_action {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(236, 237, 230, 255), stop:1 rgba(229, 231, 222, 255));
	color: rgb(108, 108, 92);
	border: 1px solid rgba(178, 178, 162, 195);
	border-radius: 10px;
	padding: 8px 14px;
	font-size: 13px;
}

QPushButton#btn_reset_action:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(224, 226, 216, 255), stop:1 rgba(215, 217, 204, 255));
	border: 1px solid rgb(148, 148, 130);
}

/* 情绪绑定区/表情库子标题（暖棕粗体，对齐整体文字色） */
QLabel#label_emotion_title, QLabel#label_expr_title, QLabel#label_action_lib_title {
	color: rgb(140, 118, 92);
	font-size: 13px;
	font-weight: bold;
	background: transparent;
}

/* 列表/表格：浅色毛玻璃 + 圆角，选中态温和高亮 */
QListWidget, QTableWidget {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(250, 249, 245, 255), stop:1 rgba(248, 247, 242, 255));
	border: 1px solid rgba(180, 175, 165, 200);
	border-radius: 10px;
	color: rgb(114, 95, 77);
}

QListWidget::item {
	padding: 4px 8px;
	border-radius: 6px;
}

QListWidget::item:hover {
	background: rgba(230, 228, 220, 255);
}

QListWidget::item:selected {
	background: rgba(190, 185, 175, 255);
	color: rgb(40, 35, 25);
}

QTableWidget {
	gridline-color: rgba(200, 195, 185, 120);
}

QTableWidget::item {
	padding: 4px;
}

QTableWidget::item:selected {
	background: rgba(190, 185, 175, 255);
	color: rgb(40, 35, 25);
}

/* 工具表格：外框用不透明实色（全局表格为半透明 1px 边框，在本无边框半透明
   窗口中 alpha 合成后极易断线/过淡，表现为外框显示不完整；此处改为实色，四边完整可见） */
QTableWidget#table_tool_status {
	border: 1px solid rgb(176, 171, 161);
	border-radius: 10px;
}

QHeaderView::section {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(235, 233, 225, 255), stop:1 rgba(225, 223, 215, 255));
	color: rgb(85, 70, 55);
	border: none;
	border-bottom: 1px solid rgba(180, 175, 165, 200);
	padding: 6px 8px;
	font-weight: bold;
}

/* QComboBox 下拉框样式（严格对齐 test222.ui：圆角 14 + 右侧下拉按钮圆角，
   防止右侧箭头区覆盖/截断；padding-right 保证文字不被箭头遮挡） */
QComboBox {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(250, 249, 245, 255), stop:1 rgba(248, 247, 242, 255));
	border: 1px solid rgba(180, 175, 165, 200);
	border-radius: 14px;
	padding: 6px 9px;
	padding-right: 34px;
	color: rgb(114, 95, 77);
}

QComboBox:focus {
	border: 2px solid rgb(140, 135, 125);
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(215, 213, 205, 255), stop:1 rgba(225, 223, 215, 255));
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 30px;
	border-left: 1px solid rgba(180, 175, 165, 200);
	border-top-right-radius: 14px;
	border-bottom-right-radius: 14px;
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(240, 238, 230, 255), stop:1 rgba(235, 233, 225, 255));
}

QComboBox::down-arrow {
	width: 12px;
	height: 12px;
	image: none;
	border: 2px solid rgb(114, 95, 77);
	border-top: none;
	border-right: none;
	margin: 5px;
}

QComboBox QAbstractItemView {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(250, 249, 245, 255), stop:1 rgba(248, 247, 242, 255));
	border: 1px solid rgba(180, 175, 165, 200);
	border-radius: 8px;
	selection-background-color: rgba(190, 185, 175, 255);
	color: rgb(114, 95, 77);
	padding: 5px;
}

/* 控制面板样式 */
QFrame#control_panel_frame {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(240, 238, 230, 255), stop:1 rgba(235, 233, 225, 255));
	border: 1px solid rgba(200, 195, 185, 180);
	border-radius: 15px;
}

/* 滚动条样式：背景透明 + 上下留圆角空间，
   避免不透明轨道盖住表格右上/右下圆角导致"边框显示不完整" */
QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 11px 1px;
	border-radius: 5px;
}

QScrollBar::handle:vertical {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(160, 155, 145, 255), stop:1 rgba(140, 135, 125, 255));
	border-radius: 5px;
	min-height: 20px;
	margin: 1px;
}

QScrollBar::handle:vertical:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(120, 115, 105, 255), stop:1 rgba(100, 95, 85, 255));
}

QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 1px 11px;
	border-radius: 5px;
}

QScrollBar::handle:horizontal {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(160, 155, 145, 255), stop:1 rgba(140, 135, 125, 255));
	border-radius: 5px;
	min-width: 20px;
	margin: 1px;
}

QScrollBar::handle:horizontal:hover {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(120, 115, 105, 255), stop:1 rgba(100, 95, 85, 255));
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	width: 0px;
	height: 0px;
}

/* 记忆页视图容器（表格 / 图谱二选一，由切换按钮控制） */
#stack_memory {
	border: 1px solid rgba(200, 195, 185, 160);
	border-radius: 10px;
	background: rgba(250, 249, 245, 200);
}

/* 记忆图谱视图（内容区由控件自绘背景，此处只加淡边框圆角） */
#graph_memory {
	border: 1px solid rgba(200, 195, 185, 160);
	border-radius: 8px;
}

/* 记忆页 - 顶部状态栏：小号浅灰文字（不抢表格主体） */
QLabel#label_memory_status {
	color: rgb(150, 143, 130);
	font-size: 12px;
}

/* 记忆页 - 视图切换按钮：深棕主操作风格，与「刷新」浅色按钮区分 */
QPushButton#btn_memory_view_toggle {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(146, 122, 96, 255), stop:0.5 rgba(132, 108, 84, 255), stop:1 rgba(120, 96, 74, 255));
	color: rgb(252, 250, 245);
	border: 1px solid rgba(96, 78, 58, 220);
	border-radius: 8px;
	padding: 8px 18px;
	font-size: 12px;
}

QPushButton#btn_memory_view_toggle:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(162, 138, 110, 255), stop:1 rgba(142, 118, 92, 255));
}

QPushButton#btn_memory_view_toggle:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
		stop:0 rgba(104, 82, 62, 255), stop:1 rgba(92, 70, 52, 255));
}

/* 记忆页 - 刷新按钮：紧凑尺寸 */
QPushButton#btn_memory_refresh {
	padding: 8px 16px;
	font-size: 12px;
	border-radius: 8px;
}

/* 记忆表格：悬停行高亮 + 单元格留白（底色/表头沿用全局 QTableWidget 奶油风格） */
QTableWidget#table_memory::item {
	padding: 4px 8px;
	border: none;
}

QTableWidget#table_memory::item:hover {
	background: rgba(233, 228, 217, 255);
}

/* 记忆详情弹窗文本：与全局输入框一致的奶油底色
   （QPlainTextEdit 不在全局 QTextEdit 选择器内，需单独声明） */
QPlainTextEdit {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(250, 249, 245, 255), stop:1 rgba(248, 247, 242, 255));
	border: 1px solid rgba(180, 175, 165, 200);
	border-radius: 14px;
	padding: 10px;
	color: rgb(114, 95, 77);
}

QPlainTextEdit:focus {
	border: 2px solid rgb(140, 135, 125);
}</string>
